{
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
    "python.terminal.activateEnvironment": true,
    "sqltools.connections": [
        {
            "previewLimit": 50,
            "driver": "SQLite",
            "name": "warehouse",
            "group": "sqlite",
            "database": "${workspaceFolder:Ct_chu_dung}/data/warehouse_locations.db"
        }
    ],
    "git.ignoreLimitWarning": true,
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true
    },
    "search.exclude": {
        "**/__pycache__": true
    }
}
