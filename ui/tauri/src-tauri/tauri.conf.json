{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Warehouse Shelf Mapper",
  "version": "0.1.0",
  "identifier": "vn.warehouse.shelfmapper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Warehouse Shelf Mapper",
        "width": 1360,
        "height": 860,
        "minWidth": 1050,
        "minHeight": 650,
        "maximized": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
